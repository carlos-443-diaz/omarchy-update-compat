# SPDX-License-Identifier: GPL-3.0-or-later
pkgname=omarchy-update-compat
pkgver=0.2.0
pkgrel=1
pkgdesc='Opt-in native application compatibility for Omarchy updates'
arch=('x86_64' 'aarch64')
url='https://github.com/carlos-443-diaz/omarchy-update-compat'
license=('GPL-3.0-or-later')
depends=('python>=3.14' 'pacman' 'libalpm.so' 'git' 'fakeroot' 'sudo')
makedepends=('gcc')
optdepends=('podman: isolated source builds')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP') # Local source snapshot; build-package.py supplies its exact hash.

build() {
  cd "$srcdir/$pkgname-$pkgver"
  cc -O2 -Wall -Wextra -Werror native/prepare.c -lalpm -o native/prepare
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  local destination="$pkgdir/usr/lib/$pkgname"
  install -d "$destination" "$pkgdir/usr/bin" "$pkgdir/usr/share/doc/$pkgname"
  cp -r omarchy_compat native builders policies wrappers "$destination/"
  find "$destination" -name __pycache__ -type d -exec rm -rf {} +
  install -Dm755 bin/omarchy-update-compat "$destination/bin/omarchy-update-compat"
  install -Dm755 libexec/privileged "$destination/privileged"
  chmod 755 "$destination/wrappers/"*
  ln -s "/usr/lib/$pkgname/bin/omarchy-update-compat" "$pkgdir/usr/bin/$pkgname"
  install -m644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -m644 ACCEPTANCE.md "$pkgdir/usr/share/doc/$pkgname/ACCEPTANCE.md"
}
