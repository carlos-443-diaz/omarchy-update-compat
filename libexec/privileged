import os
import sys

if os.geteuid() != 0:
    raise SystemExit('The package transaction helper requires sudo.')
caller = os.environ.get('SUDO_UID', '0')
os.environ.clear()
os.environ.update(PATH='/usr/bin:/bin', HOME='/root', LC_ALL='C',
                  OMARCHY_UPDATE_PACMAN='1')
sys.dont_write_bytecode = True
sys.path.insert(0, '/usr/lib/omarchy-update-compat')
from omarchy_compat.privileged import main

raise SystemExit(main(sys.argv[1:], int(caller)))
